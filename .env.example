# --- Application ---
# Port d'écoute dans le conteneur (Traefik s'y connecte, il n'est pas publié)
PORT=3000
HOST=0.0.0.0
# Chemin du fichier SQLite (hors Docker ; en Docker il est fixé par docker-compose.yml)
DATABASE_PATH=./data/interfas.db
# Secret pour signer les cookies de session (au moins 32 caractères).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire
# Niveau de log (info, warn, error, silent)
LOG_LEVEL=info
# Fuseau horaire de l'atelier pour la planification
TIMEZONE=Europe/Paris

# --- Hors Docker uniquement (docker-compose.yml force les deux à true) ---
# Cookie de session réservé au HTTPS
COOKIE_SECURE=false
# Faire confiance aux en-têtes X-Forwarded-* d'un reverse proxy
TRUST_PROXY=false

# --- Traefik (utilisé par docker-compose.yml, même schéma que passbolt) ---
# Nom de domaine de l'application (couvert par le certificat wildcard)
DISPLAY_HOST=affichage.example.lan
# Plages autorisées : LAN + VPN, séparées par des virgules
DISPLAY_ALLOWED_IPS=192.168.1.0/24,10.8.0.0/24
# Points d'entrée Traefik (mêmes valeurs que dans ~/docker/passbolt/.env)
TRAEFIK_EP_HTTPS=websecure
TRAEFIK_EP_HTTP=web
