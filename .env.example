# Port d'écoute du serveur
PORT=3000
# Adresse d'écoute (0.0.0.0 dans Docker)
HOST=0.0.0.0
# Chemin du fichier SQLite
DATABASE_PATH=./data/interfas.db
# Secret pour signer les cookies de session (au moins 32 caractères, à générer)
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire
# Niveau de log (info, warn, error, silent)
LOG_LEVEL=info
