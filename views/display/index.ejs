<div class="stage">
  <% if (messages.length === 0) { %>
    <div class="slide active">
      <div class="empty">
        <h1>Interfas</h1>
        <p>Aucun message à afficher pour le moment.</p>
      </div>
    </div>
  <% } %>
  <% messages.forEach((m, i) => { %>
    <div class="slide<%= i === 0 ? ' active' : '' %>">
      <div class="message-body"><%- m.content_html %></div>
    </div>
  <% }) %>
</div>
