<% if (messages.length === 0) { %>
  <div class="slide active">
    <div class="empty">
      <h1>Interfas</h1>
      <p>Aucun message à afficher pour le moment.</p>
    </div>
  </div>
<% } %>
<% messages.forEach((m, i) => { %>
  <div class="slide<%= i === 0 ? ' active' : '' %>" data-id="<%= m.id %>" data-duration="<%= m.duration_seconds %>"<%= m.video_file ? ' data-video' : '' %>><%- include('../partials/slide', { m }) %></div>
<% }) %>
