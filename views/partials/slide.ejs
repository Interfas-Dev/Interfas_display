<%# Rendu d'un message dans son template. Variable attendue : m %>
<% const hasSig = m.sig_name || m.sig_role;
   const images = Array.isArray(m.images) ? m.images : (() => { try { return JSON.parse(m.images_json || '[]'); } catch { return []; } })(); %>
<div class="slide-frame theme-<%= m.theme %> frame-<%= m.frame %>" data-slide>
  <header class="slide-head"<%= (!m.show_logo && !m.heading) ? ' hidden' : '' %>>
    <img class="slide-logo" src="/public/img/logo-interfas.png" alt="INTERFAS"<%= m.show_logo ? '' : ' hidden' %>>
    <h1 class="slide-heading"<%= m.heading ? '' : ' hidden' %>><%= m.heading %></h1>
  </header>
  <div class="message-body slide-body"><%- m.content_html %></div>
  <div class="slide-signature"<%= hasSig ? '' : ' hidden' %>>
    <span class="sig-name"><%= m.sig_name %></span>
    <span class="sig-role"><%= m.sig_role %></span>
  </div>
  <% images.forEach((img) => { %>
    <div class="slide-image layer-<%= img.layer === 'back' ? 'back' : 'front' %>" style="left:<%= Number(img.x) %>%;top:<%= Number(img.y) %>%;width:<%= Number(img.w) %>%">
      <% if (/\.(mp4|webm)$/.test(img.file)) { %><video src="/media/<%= img.file %>#t=0.1" muted loop playsinline preload="metadata"<%= img.sound ? ' data-sound' : '' %>></video><% } else { %><img src="/media/<%= img.file %>" alt="" draggable="false"><% } %>
    </div>
  <% }) %>
  <%# Vidéo plein écran : recouvre toute la diapo, affichée le temps de la vidéo. %>
  <div class="slide-fullvideo"<%= m.video_file ? '' : ' hidden' %>>
    <% if (m.video_file) { %><video src="/media/<%= m.video_file %>#t=0.1" muted playsinline preload="metadata"<%= m.video_sound ? ' data-sound' : '' %>></video><% } %>
  </div>
</div>
