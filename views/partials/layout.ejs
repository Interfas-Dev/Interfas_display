<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Interfas Display</title>
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/admin">Interfas Display</a>
    <nav>
      <a href="/display" target="_blank" rel="noopener">Ouvrir l'écran</a>
      <% if (locals.user) { %>
        <a href="/admin/account"><%= user.display_name %></a>
        <form method="post" action="/admin/logout" class="inline">
          <button type="submit" class="link">Déconnexion</button>
        </form>
      <% } %>
    </nav>
  </header>
  <main class="container">
    <%- body %>
  </main>
</body>
</html>
