<% const current = templates.find((t) => t.id === message.template_id) || templates[0]; %>
<div class="page-head">
  <h1><%= title %></h1>
  <a href="/admin/messages">← Retour aux messages</a>
</div>

<form method="post" action="/admin/messages<%= message.id ? '/' + message.id : '' %>" class="message-form" id="message-form">
  <div class="editor-col">
    <label class="field">Template
      <select name="template_id" id="template_id" data-templates="<%= JSON.stringify(templates.map((t) => ({ id: t.id, theme: t.theme, frame: t.frame, show_logo: t.show_logo, sig_name: t.default_signature_name, sig_role: t.default_signature_role, look: look(t) }))) %>">
        <% templates.forEach((t) => { %>
          <option value="<%= t.id %>" <%= current && t.id === current.id ? 'selected' : '' %>><%= t.name %></option>
        <% }) %>
      </select>
      <% if (errors.template_id) { %><span class="field-error"><%= errors.template_id %></span><% } %>
      <% if (user.role === 'admin') { %><span class="hint">Les templates se modifient dans <a href="/admin/templates">Paramètres</a>.</span><% } %>
    </label>

    <label class="field">Titre affiché
      <input name="heading" id="heading" value="<%= message.heading %>" maxlength="<%= limits.heading %>" placeholder="Ex. FORMATION HOROQUARTZ">
      <% if (errors.heading) { %><span class="field-error"><%= errors.heading %></span><% } %>
    </label>

    <div class="field">
      <span>Texte</span>
      <div class="editor">
        <div class="toolbar" role="toolbar" aria-label="Mise en forme" hidden>
          <select data-cmd="block" aria-label="Style de paragraphe">
            <option value="p">Texte</option>
            <option value="h1">Titre 1</option>
            <option value="h2">Titre 2</option>
            <option value="h3">Titre 3</option>
          </select>
          <select data-cmd="fontSize" aria-label="Taille du texte">
            <option value="">Taille</option>
            <% fontSizes.forEach((s) => { %><option value="<%= s %>"><%= Math.round(parseFloat(s) * 100) %> %</option><% }) %>
          </select>
          <span class="sep"></span>
          <button type="button" data-cmd="bold" title="Gras"><b>G</b></button>
          <button type="button" data-cmd="italic" title="Italique"><i>I</i></button>
          <button type="button" data-cmd="underline" title="Souligné"><u>S</u></button>
          <button type="button" data-cmd="strike" title="Barré"><s>B</s></button>
          <span class="sep"></span>
          <span class="swatches" aria-label="Couleurs de la charte">
            <% brandColors.forEach((c) => { %><button type="button" class="swatch" data-cmd="color" data-value="<%= c.value %>" title="Texte <%= c.name %>" aria-label="Texte <%= c.name %>" style="--swatch: <%= c.value %>"></button><% }) %>
          </span>
          <label class="color" title="Autre couleur de texte">A<input type="color" data-cmd="color" value="#ffffff"></label>
          <label class="color highlight" title="Surlignage (aplat)">▮<input type="color" data-cmd="highlight" value="#de3619"></label>
          <button type="button" data-cmd="clearColor" title="Retirer couleurs et surlignage">⌫</button>
          <span class="sep"></span>
          <button type="button" data-cmd="alignLeft" title="Aligner à gauche">⯇</button>
          <button type="button" data-cmd="alignCenter" title="Centrer">≡</button>
          <button type="button" data-cmd="alignRight" title="Aligner à droite">⯈</button>
          <span class="sep"></span>
          <button type="button" data-cmd="bulletList" title="Liste à puces">•</button>
          <button type="button" data-cmd="orderedList" title="Liste numérotée">1.</button>
          <span class="sep"></span>
          <button type="button" data-cmd="undo" title="Annuler">↶</button>
          <button type="button" data-cmd="redo" title="Rétablir">↷</button>
        </div>
        <% const curLook = current ? look(current) : { css: '' }; %><div class="editor-surface theme-<%= current ? current.theme : 'light' %>" id="editor"<% if (curLook.css) { %> style="<%= curLook.css %>"<% } %>></div>
        <noscript><p class="field-error">L'éditeur nécessite JavaScript.</p></noscript>
      </div>
      <input type="hidden" name="content" id="content" value="<%= message.content_html %>">
      <% if (errors.content) { %><span class="field-error"><%= errors.content %></span><% } %>
    </div>

    <fieldset class="field-group">
      <legend>Signature (en bas à droite)</legend>
      <div class="field-row">
        <label class="field">Nom
          <input name="signature_name" id="signature_name" value="<%= message.signature_name %>" maxlength="<%= limits.signature %>" placeholder="<%= current ? current.default_signature_name : '' %>">
        </label>
        <label class="field">Fonction
          <input name="signature_role" id="signature_role" value="<%= message.signature_role %>" maxlength="<%= limits.signature %>" placeholder="<%= current ? current.default_signature_role : '' %>">
        </label>
      </div>
      <% if (errors.signature) { %><span class="field-error"><%= errors.signature %></span><% } %>
      <span class="hint">Laisse vide pour utiliser la signature par défaut du template.</span>
    </fieldset>

    <label class="field">Titre interne (facultatif)
      <input name="title" value="<%= message.title %>" maxlength="<%= limits.title %>" placeholder="Par défaut : le titre affiché">
      <% if (errors.title) { %><span class="field-error"><%= errors.title %></span><% } %>
      <span class="hint">Sert seulement à retrouver le message dans la liste.</span>
    </label>

    <fieldset class="field-group">
      <legend>Diffusion</legend>
      <label class="checkbox">
        <input type="checkbox" name="is_active" value="on" <%= message.is_active ? 'checked' : '' %>>
        Diffuser ce message à l'écran
      </label>

      <label class="field field-inline">Durée d'affichage
        <span class="input-suffix">
          <input type="number" name="duration_seconds" value="<%= message.duration_seconds %>" min="<%= duration.min %>" max="<%= duration.max %>" step="1" required>
          <span>secondes</span>
        </span>
      </label>
      <% if (errors.duration) { %><span class="field-error"><%= errors.duration %></span><% } %>

      <div class="field-row">
        <label class="field">Début (facultatif)
          <input type="datetime-local" name="starts_at" value="<%= message.starts_at || '' %>">
        </label>
        <label class="field">Fin (facultatif)
          <input type="datetime-local" name="ends_at" value="<%= message.ends_at || '' %>">
        </label>
      </div>
      <% if (errors.period) { %><span class="field-error"><%= errors.period %></span><% } %>

      <div class="field">
        <span>Jours</span>
        <div class="day-picker">
          <% dayLabels.forEach((d, i) => { %>
            <label class="day"><input type="checkbox" name="days" value="<%= i %>" <%= (message.days_mask & (1 << i)) ? 'checked' : '' %>><span><%= d %></span></label>
          <% }) %>
        </div>
      </div>
      <% if (errors.days) { %><span class="field-error"><%= errors.days %></span><% } %>

      <div class="field-row">
        <label class="field">Chaque jour de (facultatif)
          <input type="time" name="daily_start" value="<%= message.daily_start || '' %>">
        </label>
        <label class="field">à
          <input type="time" name="daily_end" value="<%= message.daily_end || '' %>">
        </label>
      </div>
      <% if (errors.daily) { %><span class="field-error"><%= errors.daily %></span><% } %>
      <span class="hint">Heure de l'atelier (Paris). Sans date ni plage horaire, le message passe en continu.</span>
    </fieldset>

    <div class="form-actions">
      <button type="submit" class="btn primary">Enregistrer</button>
      <a class="btn" href="/admin/messages">Annuler</a>
    </div>
  </div>

  <aside class="preview-col">
    <h2>Aperçu à l'écran</h2>
    <div class="screen-preview" id="preview">
      <%- include('../../partials/slide', { m: {
        theme: current ? current.theme : 'light', frame: current ? current.frame : 'none', show_logo: current ? current.show_logo : 1,
        style_json: current ? current.style_json : '{}',
        heading: message.heading, content_html: message.content_html, images_json: message.images_json,
        video_file: message.video_file, video_sound: message.video_sound,
        sig_name: (message.signature_name || message.signature_role) ? message.signature_name : (current ? current.default_signature_name : ''),
        sig_role: (message.signature_name || message.signature_role) ? message.signature_role : (current ? current.default_signature_role : ''),
      } }) %>
    </div>
    <p class="muted small">Aperçu en 16:9. Les tailles s'adaptent à la résolution réelle de l'écran.</p>

    <div class="image-panel" id="image-panel">
      <input type="hidden" name="images" id="images" value="<%= message.images_json %>">
      <div class="image-actions">
        <label class="btn" id="image-add">
          Ajouter une image ou une vidéo
          <input type="file" id="image-file" accept="image/png,image/jpeg,image/webp,image/gif,video/mp4,video/webm" hidden>
        </label>
        <span class="image-tools" id="image-tools" hidden>
          <button type="button" class="btn" id="image-sound" aria-pressed="false" hidden>🔇 Sans le son</button>
          <button type="button" class="btn" id="image-layer">Passer derrière le texte</button>
          <button type="button" class="btn danger" id="image-remove">Retirer</button>
        </span>
      </div>
      <p class="muted small" id="image-status" role="status">Glisse une image ou une vidéo pour la déplacer, tire son coin pour la redimensionner. Images PNG, JPG ou WebP (5 Mo), GIF animés (20 Mo) ; vidéos MP4 ou WebM (200 Mo), lues en boucle.</p>
      <% if (errors.images) { %><span class="field-error"><%= errors.images %></span><% } %>

      <fieldset class="field-group video-full">
        <legend>Vidéo plein écran</legend>
        <input type="hidden" name="video_file" id="video_file" value="<%= message.video_file || '' %>">
        <p class="small" id="video-full-name"><%= message.video_file ? 'Vidéo plein écran choisie.' : 'Aucune vidéo plein écran.' %></p>
        <div class="image-actions">
          <label class="btn">
            <%= message.video_file ? 'Remplacer la vidéo' : 'Choisir une vidéo' %>
            <input type="file" id="video-full-file" accept="video/mp4,video/webm" hidden>
          </label>
          <button type="button" class="btn danger" id="video-full-remove"<%= message.video_file ? '' : ' hidden' %>>Retirer la vidéo</button>
        </div>
        <label class="checkbox"><input type="checkbox" name="video_sound" id="video_sound" value="on" <%= message.video_sound ? 'checked' : '' %> <%= message.video_file ? '' : 'disabled' %>> Avec le son</label>
        <span class="hint">Le message n'affiche alors que la vidéo, en plein écran, et reste à l'écran le temps de la vidéo (la durée d'affichage est ignorée).</span>
        <% if (errors.video) { %><span class="field-error"><%= errors.video %></span><% } %>
      </fieldset>
    </div>
  </aside>
</form>
<script src="/public/js/preview.js"></script>
<script src="/public/js/images.js"></script>
<script type="module" src="/public/build/editor.js"></script>
