<div class="page-head">
  <div>
    <h1>Messages</h1>
    <p class="muted"><%= messages.filter((m) => m.status === 'live').length %> en diffusion en ce moment sur <%= messages.length %>. Les messages défilent dans cet ordre.</p>
  </div>
  <a class="btn primary" href="/admin/messages/new">Nouveau message</a>
</div>

<section class="live-panel" aria-labelledby="live-title">
  <div class="live-screen">
    <iframe src="/display" title="Écran de l'atelier en direct" loading="lazy" tabindex="-1"></iframe>
  </div>
  <div class="live-info">
    <h2 id="live-title"><span class="live-dot" aria-hidden="true"></span> En ce moment à l'écran</h2>
    <p class="muted small">L'aperçu montre exactement ce que diffuse l'écran de l'atelier, en temps réel. Chaque modification enregistrée ici y apparaît en quelques secondes.</p>
    <a class="btn" href="/display" target="_blank" rel="noopener">Ouvrir en plein écran</a>
  </div>
</section>

<% if (messages.length === 0) { %>
  <div class="empty-state card">
    <p>Aucun message pour l'instant.</p>
    <a class="btn primary" href="/admin/messages/new">Créer le premier message</a>
  </div>
<% } else { %>
  <ul class="message-list">
    <% messages.forEach((m, i) => { %>
      <li class="message-row<%= m.status === 'live' ? '' : ' is-inactive' %>">
        <a class="thumb" href="/admin/messages/<%= m.id %>/edit" aria-label="Modifier <%= m.title %>">
          <div class="screen-preview"><%- include("../../partials/slide", { m }) %></div>
        </a>
        <div class="message-info">
          <div class="message-title">
            <a href="/admin/messages/<%= m.id %>/edit"><%= m.title %></a>
            <span class="badge status-<%= m.status %>"><%= m.statusLabel %></span>
          </div>
          <p class="small schedule-line"><span title="Durée d'affichage">⏱ <%= m.video_file ? 'durée de la vidéo' : m.duration_seconds + ' s' %></span> · <span title="Planification">🗓 <%= m.scheduleText %></span></p>
          <p class="muted small"><%= m.template_name ? "Template : " + m.template_name + " · " : "" %>Modifié le <%= new Date(m.updated_at + 'Z').toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'Europe/Paris' }) %><%= m.updated_by_name ? ' par ' + m.updated_by_name : '' %></p>
        </div>
        <div class="message-actions">
          <form method="post" action="/admin/messages/<%= m.id %>/move" class="inline">
            <input type="hidden" name="direction" value="up">
            <button class="btn icon" title="Monter" aria-label="Monter" <%= i === 0 ? 'disabled' : '' %>>↑</button>
          </form>
          <form method="post" action="/admin/messages/<%= m.id %>/move" class="inline">
            <input type="hidden" name="direction" value="down">
            <button class="btn icon" title="Descendre" aria-label="Descendre" <%= i === messages.length - 1 ? 'disabled' : '' %>>↓</button>
          </form>
          <form method="post" action="/admin/messages/<%= m.id %>/toggle" class="inline">
            <input type="hidden" name="active" value="<%= m.is_active ? '0' : '1' %>">
            <button class="btn"><%= m.is_active ? 'Désactiver' : 'Activer' %></button>
          </form>
          <a class="btn" href="/admin/messages/<%= m.id %>/edit">Modifier</a>
          <form method="post" action="/admin/messages/<%= m.id %>/delete" class="inline" data-confirm="Supprimer définitivement « <%= m.title %> » ?">
            <button class="btn danger">Supprimer</button>
          </form>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>
