{
  "name": "interfas-display",
  "version": "0.1.0",
  "description": "Outil d affichage de messages pour l atelier Interfas",
  "scripts": {
    "dev": "npm run build:client && tsx watch src/index.ts",
    "build": "npm run build:client && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p client/tsconfig.json",
    "user:create": "tsx src/cli/create-user.ts",
    "build:client": "esbuild client/editor.ts --bundle --minify --format=esm --target=es2022 --outdir=public/build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfas-dev/interfas_display.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fastify/view": "^12.0.1",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "ejs": "^7.0.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
